generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  username         String?   @unique
  firstName        String?
  lastName         String?
  bio              String?
  timezone         String?   @default("UTC")
  preferences      Json?     @default("{}")
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  twoFactorEnabled Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  UserStoryAssignees      UserStoryAssignees[]
  accounts                Account[]
  auditLogs               AuditLog[]
  ChannelMember           ChannelMember[]
  comments                Comment[]
  features                Feature[]
  fields                  fields[]
  FileVersion             FileVersion[]
  fileUploads             File[]
  initiatives             Initiative[]
  ownedItems              Item[]               @relation("ItemOwner")
  Message                 Message[]
  notifications           Notification[]
  projectMemberships      ProjectMember[]
  sessions                Session[]
  createdTasks            Task[]               @relation("TaskCreator")
  organizationMemberships TeamMember[]
  timeEntries             TimeEntry[]
  createdUserStories      UserStory[]          @relation("UserStoryCreator")
  assignedItems           Item[]               @relation("ItemAssignees")
  projects                Project[]            @relation("ProjectOwner")
  sprints                 Sprint[]             @relation("SprintToUser")
  assignedTasks           Task[]               @relation("TaskAssignees")

  @@map("users")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("account")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userAgent String?
  ipAddress String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

////////////////////
////    Team      ////
//////////////////////

model Team {
  id           String       @id @default(cuid())
  name         String
  order        Int          @default(1000)
  description  String?
  slug         String       @unique
  logoUrl      String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  parentTeamId String?
  fields       fields[] /// Champs personnalisés
  members      TeamMember[]
  parentTeam   Team?        @relation("TeamHierarchy", fields: [parentTeamId], references: [id])
  children     Team[]       @relation("TeamHierarchy")
  templates    Template[] /// Templates associés

  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  role     UserRole @default(DEVELOPER) /// Rôle dans l'équipe
  order    Int      @default(1000)
  joinedAt DateTime @default(now()) /// Date d'adhésion
  isActive Boolean  @default(true)
  teamId   String
  userId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String?
  slug        String
  key         String /// Clé unique (ex: PROJ)
  order       Int             @default(1000)
  startDate   DateTime?
  endDate     DateTime?
  status      String          @default("ACTIVE")
  visibility  String          @default("PRIVATE") /// Visibilité (PUBLIC, PRIVATE, INT, ERNAL)
  settings    Json?           @default("{}") /// Paramètres spécifiques
  metadata    Json?           @default("{}") /// Métadonnées personnalisées
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  channels    Channel[] /// Canaux de discussion
  features    Feature[]
  fields      fields[] /// Champs personnalisés
  files       File[]
  initiatives Initiative[]
  members     ProjectMember[]
  sprints     Sprint[]
  templates   Template[]
  user        User[]          @relation("ProjectOwner") /// Propriétaires du projet

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  role      UserRole @default(DEVELOPER)
  order     Int      @default(1000)
  joinedAt  DateTime @default(now())
  isActive  Boolean  @default(true)
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Initiative {
  id          String    @id @default(cuid())
  name        String
  order       Int       @default(1000)
  description String?
  objective   String? /// Objectif stratégique
  priority    Priority  @default(MEDIUM)
  status      String    @default("ACTIVE")
  startDate   DateTime?
  endDate     DateTime?
  progress    Float     @default(0)
  budget      Float?
  roi         Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projectId   String
  userId      String?
  epics       Epic[]
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])

  @@map("initiatives")
}

model Epic {
  id           String      @id @default(cuid())
  name         String
  order        Int         @default(1000)
  description  String?
  priority     Priority    @default(MEDIUM)
  status       String      @default("ACTIVE")
  startDate    DateTime?
  endDate      DateTime?
  progress     Float       @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  initiativeId String
  initiative   Initiative  @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  features     Feature[]
  userstories  UserStory[]

  @@map("epics")
}

model Feature {
  id                 String              @id @default(cuid())
  name               String
  order              Int                 @default(1000)
  description        String?
  acceptanceCriteria String?
  priority           Priority            @default(MEDIUM)
  status             String              @default("ACTIVE")
  storyPoints        Int?
  businessValue      Int?
  technicalRisk      Int?
  effort             Int?
  startDate          DateTime?
  endDate            DateTime?
  progress           Float               @default(0)
  position           Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  epicId             String
  parentId           String?
  projectId          String?
  userId             String?
  dependencies       FeatureDependency[] @relation("DependentFeature")
  dependents         FeatureDependency[] @relation("DependsOnFeature")
  epic               Epic                @relation(fields: [epicId], references: [id], onDelete: Cascade)
  parent             Feature?            @relation("FeatureHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children           Feature[]           @relation("FeatureHierarchy")
  Project            Project?            @relation(fields: [projectId], references: [id])
  users              User?               @relation(fields: [userId], references: [id])
  files              File[]
  userStories        UserStory[]

  @@map("features")
}

model FeatureDependency {
  id                 String   @id @default(cuid())
  type               String   @default("DEPENDS_ON") /// Type de dépendance
  order              Int      @default(1000)
  description        String?
  createdAt          DateTime @default(now())
  dependentFeatureId String
  dependsOnFeatureId String
  dependentFeature   Feature  @relation("DependentFeature", fields: [dependentFeatureId], references: [id], onDelete: Cascade)
  dependsOnFeature   Feature  @relation("DependsOnFeature", fields: [dependsOnFeatureId], references: [id], onDelete: Cascade)

  @@unique([dependentFeatureId, dependsOnFeatureId])
  @@map("feature_dependencies")
}

model UserStory {
  id                 String                @id @default(cuid())
  title              String
  order              Int                   @default(1000)
  description        String?
  acceptanceCriteria String? // Critères d'acceptation
  priority           Priority              @default(MEDIUM)
  status             TaskStatus            @default(TODO)
  storyPoints        Int?
  businessValue      Int? // Valeur métier
  technicalRisk      Int? // Risque technique
  effort             Int?
  position           Int                   @default(0)
  labels             String[]              @default([])
  tags               String[]              @default([])
  estimatedHours     Float?
  actualHours        Float?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  featureId          String
  creatorId          String
  UserStoryAssignees UserStoryAssignees[]
  comments           Comment[]
  files              File[]
  tasks              Task[]
  timeEntries        TimeEntry[]
  creator            User                  @relation("UserStoryCreator", fields: [creatorId], references: [id])
  feature            Feature               @relation(fields: [featureId], references: [id], onDelete: Cascade)
  dependencies       UserStoryDependency[] @relation("DependentUserStory")
  dependents         UserStoryDependency[] @relation("DependsOnUserStory")
  sprints            Sprint[]              @relation("SprintUserStories")
  Epic               Epic[]

  @@map("user_stories")
}

model UserStoryDependency {
  id                   String    @id @default(cuid())
  type                 String    @default("DEPENDS_ON")
  order                Int       @default(1000)
  description          String?
  createdAt            DateTime  @default(now())
  dependentUserStoryId String
  dependsOnUserStoryId String
  dependentUserStory   UserStory @relation("DependentUserStory", fields: [dependentUserStoryId], references: [id], onDelete: Cascade)
  dependsOnUserStory   UserStory @relation("DependsOnUserStory", fields: [dependsOnUserStoryId], references: [id], onDelete: Cascade)

  @@unique([dependentUserStoryId, dependsOnUserStoryId])
  @@map("user_story_dependencies")
}

model Task {
  id             String           @id @default(cuid())
  title          String
  order          Int              @default(1000)
  description    String?
  priority       Priority         @default(MEDIUM)
  status         TaskStatus       @default(TODO)
  type           String           @default("TASK") /// Type (TASK, BUG, etc.)
  position       Int              @default(0) // Position dans le backlog
  labels         String[]         @default([])
  tags           String[]         @default([])
  estimatedHours Float?
  actualHours    Float?
  dueDate        DateTime?
  startDate      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  userStoryId    String
  creatorId      String
  comments       Comment[]
  files          File[]
  dependencies   TaskDependency[] @relation("DependentTask")
  dependents     TaskDependency[] @relation("DependsOnTask")
  creator        User             @relation("TaskCreator", fields: [creatorId], references: [id])
  userStory      UserStory        @relation(fields: [userStoryId], references: [id], onDelete: Cascade)
  timeEntries    TimeEntry[]
  assignees      User[]           @relation("TaskAssignees")

  @@map("tasks")
}

model TaskDependency {
  id              String   @id @default(cuid())
  type            String   @default("DEPENDS_ON")
  order           Int      @default(1000)
  description     String?
  createdAt       DateTime @default(now())
  dependentTaskId String
  dependsOnTaskId String /// Tâche requise
  dependentTask   Task     @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task     @relation("DependsOnTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, dependsOnTaskId])
  @@map("task_dependencies")
}

model Sprint {
  id            String       @id @default(cuid())
  name          String
  order         Int          @default(1000)
  goal          String?
  description   String?
  startDate     DateTime
  endDate       DateTime
  status        SprintStatus @default(PLANNED) // Statut (PLANNED, ACTIVE, etc.)
  capacity      Int? /// Capacité (en points/heures)
  velocity      Float? /// Vélocité moyenne
  burndownData  Json?        @default("{}") // Données du burndown chart
  retrospective Json?        @default("{}") // Notes de rétrospective
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  projectId     String
  files         File[]
  items         Item[] // Éléments du backlog inclus
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeEntries   TimeEntry[]
  users         User[]       @relation("SprintToUser")
  userStories   UserStory[]  @relation("SprintUserStories")

  @@map("sprints")
}

model File {
  id          String        @id @default(cuid())
  name        String
  order       Int           @default(1000)
  type        FileType // Type (DOSSIER, PAGE, COMPONENT, etc.)
  mimeType    String?
  path        String? /// Chemin dans l'application
  description String?
  import      String?
  use         String? // Cas d'usage (bibliothèque, lib, utils, store, hook, ...)
  export      String?
  script      String? // script du fichier
  version     Int           @default(1) // Version actuelle
  isFolder    Boolean       @default(false)
  metadata    Json?         @default("{}")
  tags        String[]      @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  parentId    String?
  projectId   String
  featureId   String?
  userStoryId String?
  taskId      String?
  sprintId    String?
  comments    Comment[]
  versions    FileVersion[] // Historique des versions
  feature     Feature?      @relation(fields: [featureId], references: [id], onDelete: Cascade)
  parent      File?         @relation("FileHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    File[]        @relation("FileHierarchy")
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint      Sprint?       @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task        Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User[] // ✅ AUTEURS/DÉVELOPPEURS (pas uploaders)
  userStory   UserStory?    @relation(fields: [userStoryId], references: [id], onDelete: Cascade)
  items       Item[]        @relation("FileToItem")

  @@map("files")
}

model FileVersion {
  id        String   @id @default(cuid())
  version   Int
  url       String
  size      Int
  checksum  String?
  changelog String?
  createdAt DateTime @default(now())
  fileId    String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, version])
  @@map("file_versions")
}

model Comment {
  id              String       @id @default(cuid())
  title           String
  order           Int          @default(1000)
  content         String
  mentions        String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  authorId        String
  taskId          String?
  userStoryId     String?
  fileId          String?
  itemId          String?
  parentCommentId String?
  blogImage       String?
  excerpt         String?
  isActive        Boolean      @default(true)
  isPinned        Boolean      @default(false)
  isResolved      Boolean      @default(false)
  metadata        Json?        @default("{}")
  publishedAt     DateTime?
  readingTime     Int?
  slug            String?      @unique
  status          String       @default("DRAFT")
  visibility      Visibility   @default(PRIVATE)
  author          User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  file            File?        @relation(fields: [fileId], references: [id], onDelete: Cascade)
  item            Item?        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  parentComment   Comment?     @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]    @relation("CommentReplies")
  task            Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userStory       UserStory?   @relation(fields: [userStoryId], references: [id], onDelete: Cascade)
  blog_tags       blog_tags[]  @relation("CommentBlogTags")
  categories      categories[] @relation("CommentCategories")

  @@map("comments")
}

model Channel {
  id          String          @id @default(cuid())
  name        String /// Nom du canal
  order       Int             @default(1000)
  description String?
  type        String          @default("TEXT") // Type (TEXT, VOICE, VIDEO)
  isPrivate   Boolean         @default(false)
  isArchived  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  projectId   String
  members     ChannelMember[]
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@map("channels")
}

model ChannelMember {
  id        String   @id @default(cuid())
  order     Int      @default(1000)
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())
  channelId String
  userId    String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@map("channel_members")
}

model Message {
  id        String   @id @default(cuid())
  order     Int      @default(1000)
  content   String
  type      String   @default("TEXT")
  metadata  Json?    @default("{}")
  mentions  String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  channelId String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Template {
  id          String   @id @default(cuid())
  name        String
  order       Int      @default(1000)
  description String?
  type        String
  category    String?
  content     Json
  isPublic    Boolean  @default(false)
  isSystem    Boolean  @default(false)
  version     String   @default("1.0.0")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teamId      String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("templates")
}

model TimeEntry {
  id          String     @id @default(cuid())
  description String?
  hours       Float
  date        DateTime
  startTime   DateTime?
  endTime     DateTime?
  isManual    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String
  taskId      String?
  userStoryId String?
  sprintId    String?
  itemId      String?
  item        Item?      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sprint      Sprint?    @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userStory   UserStory? @relation(fields: [userStoryId], references: [id], onDelete: Cascade)

  @@map("time_entries")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  data      Json?            @default("{}")
  read      Boolean          @default(false) // Lu ?
  readAt    DateTime? /// Date de lecture
  createdAt DateTime         @default(now())
  userId    String // Destinataire
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  metadata  Json?    @default("{}")
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model Item {
  id                 String      @id @default(cuid())
  type               String
  name               String
  description        String?
  objective          String?
  slug               String
  key                String?
  priority           Priority?   @default(MEDIUM)
  acceptanceCriteria String?
  storyPoints        Int?
  businessValue      Int?
  technicalRisk      Int?
  effort             Int?
  progress           Int?
  status             ItemStatus  @default(ACTIVE)
  visibility         Visibility  @default(PRIVATE)
  startDate          DateTime?
  endDate            DateTime?
  completedAt        DateTime?
  settings           Json?       @default("{}")
  metadata           Json?       @default("{}")
  text               Json?       @default("{}")
  backlogPosition    Int?
  DoD                String?
  isActive           Boolean     @default(true)
  estimatedHours     Int?
  actualHours        Int?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  parentId           String?
  sprintId           String?
  userId             String
  comments           Comment[]
  parent             Item?       @relation("ItemHierarchy", fields: [parentId], references: [id])
  children           Item[]      @relation("ItemHierarchy")
  sprint             Sprint?     @relation(fields: [sprintId], references: [id])
  user               User        @relation("ItemOwner", fields: [userId], references: [id], onDelete: Cascade)
  timeEntries        TimeEntry[]
  files              File[]      @relation("FileToItem")
  assignees          User[]      @relation("ItemAssignees")

  @@map("items")
}

model Glossary {
  id          String   @id @default(cuid())
  term        String //titre
  order       Int      @default(1000)
  description String?
  type        String   @default("TERM") // "TERM" "ACRONYM" "CONCEPT" "TOOL" "PROCESS" "ROLE" "METHODOLOGY" "FRAMEWORK" "TECHNOLOGY"
  category    String?  @default("") // champ libre ('SCRUM'...) 
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("glossary")
}

model UserStoryAssignees {
  A            String
  B            String
  users        User      @relation(fields: [A], references: [id], onDelete: Cascade)
  user_stories UserStory @relation(fields: [B], references: [id], onDelete: Cascade)

  @@id([A, B], map: "_UserStoryAssignees_AB_pkey")
  @@index([B], map: "_UserStoryAssignees_B_index")
  @@map("_UserStoryAssignees")
}

model blog_tags {
  id           String      @id
  name         String
  order        Int         @default(1000)
  color        String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime
  categoriesId String?
  categories   categories? @relation(fields: [categoriesId], references: [id])
  comments     Comment[]   @relation("CommentBlogTags")
}

model categories {
  id               String       @id
  name             String
  order            Int          @default(1000)
  slug             String?      @unique
  description      String?
  color            String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime
  parentId         String?
  blog_tags        blog_tags[]
  categories       categories?  @relation("categoriesTocategories", fields: [parentId], references: [id])
  other_categories categories[] @relation("categoriesTocategories")
  comments         Comment[]    @relation("CommentCategories")
}

model fields {
  id           String   @id
  name         String
  type         String
  isRequired   Boolean  @default(false)
  isUnique     Boolean  @default(false)
  isPrimary    Boolean  @default(false)
  isArray      Boolean  @default(false)
  isOptional   Boolean  @default(true)
  minLength    Int?
  maxLength    Int?
  minValue     Float?
  maxValue     Float?
  pattern      String?
  defaultValue String?
  enumValues   String[] @default([])
  relationName String?
  relationTo   String?
  relationType String?
  onDelete     String?
  isIndexed    Boolean  @default(false)
  indexType    String?
  description  String?
  comment      String?
  tags         String[] @default([])
  category     String?
  order        Int      @default(1000)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  parentId     String?
  ownerId      String
  projectId    String?
  teamId       String?
  users        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fields       fields?  @relation("fieldsTofields", fields: [parentId], references: [id])
  other_fields fields[] @relation("fieldsTofields")
  projects     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teams        Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

